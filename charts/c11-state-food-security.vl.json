{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Foodbank 2025 estimates of moderate or severe food insecurity by state and territory. Colour shows percentage of households. Daggers identify NT and ACT, with sample bases of 102 and 69. Generalised ABS 2016 state boundaries are reused for display.",
  "width": 740,
  "height": 560,
  "padding": 24,
  "background": "#fffefa",

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/australia-ocean.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_ocean"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#edf3f5",
        "stroke": null
      }
    },

    {
      "data": {
        "url": "data/australia_graticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_graticules"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#c8d2d3",
        "strokeWidth": 0.5,
        "opacity": 0.65
      }
    },

    {
      "data": {
        "url": "data/australia-states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },

      "transform": [
        {
          "calculate": "toNumber(datum.properties.STE_CODE16)",
          "as": "state_code"
        },
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/foodbank-state-2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "state_code": "number",
                  "moderate_or_severe_pct": "number",
                  "sample_n": "number"
                }
              }
            },
            "key": "state_code",
            "fields": [
              "moderate_or_severe_pct",
              "sample_n"
            ]
          }
        },
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/state-map-positions.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "state_code": "number",
                  "longitude": "number",
                  "latitude": "number"
                }
              }
            },
            "key": "state_code",
            "fields": [
              "longitude",
              "latitude",
              "state_abbr"
            ]
          }
        },
        {
            "calculate": "datum.state_abbr + (datum.state_code === 7 ? ' ' + format(datum.moderate_or_severe_pct, '.0f') + '%' : '') + (datum.state_code >= 7 ? ' †' : '')",
            "as": "map_label"
        },
        {
          "calculate": "toNumber(datum.longitude) + 2.5",
          "as": "label_longitude"
        }
      ],

      "encoding": {
        "tooltip": [
          {
            "field": "properties.STE_NAME16",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "moderate_or_severe_pct",
            "type": "quantitative",
            "title": "Moderate or severe food insecurity (%)",
            "format": ".0f"
          },
          {
            "field": "sample_n",
            "type": "quantitative",
            "title": "Survey sample (respondents)",
            "format": ",.0f"
          }
        ]
      },

      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "fill": "#e8ede7",
            "stroke": "#fffefa",
            "strokeWidth": 1.5
          },
          "encoding": {
            "tooltip": [
              {
                "field": "properties.STE_NAME16",
                "type": "nominal",
                "title": "State or territory"
              }
            ]
          }
        },

        {
          "transform": [
            {
              "filter": "isValid(datum.moderate_or_severe_pct)"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#fffefa",
            "strokeWidth": 1.5
          },
          "encoding": {
            "color": {
              "field": "moderate_or_severe_pct",
              "type": "quantitative",
              "scale": {
                "domain": [0, 50],
                "range": ["#f2ecf0", "#65405d"],
                "clamp": true
              },
              "legend": {
                "title": "Households experiencing moderate or severe food insecurity",
                "orient": "bottom",
                "direction": "horizontal",
                "values": [0, 10, 20, 30, 40, 50],
                "labelExpr": "datum.value + '%'",
                "gradientLength": 440,
                "gradientThickness": 16,
                "titlePadding": 12,
                "offset": 24
              }
            }
          }
        },

        {
          "transform": [
            {
              "filter": "datum.state_code !== 8"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 18,
            "fontWeight": 600,
            "align": "center",
            "baseline": "middle"
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "map_label",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "datum.moderate_or_severe_pct >= 40",
                "value": "#fffefa"
              },
              "value": "#171717"
            }
          }
        },

        {
          "transform": [
            {
              "filter": "datum.state_code === 8"
            }
          ],
          "mark": {
            "type": "rule",
            "color": "#223b36",
            "strokeWidth": 1.5,
            "aria": false
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "label_longitude"
            },
            "latitude2": {
              "field": "latitude"
            }
          }
        },

        {
          "transform": [
            {
              "filter": "datum.state_code === 8"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 18,
            "fontWeight": 600,
            "align": "left",
            "baseline": "middle",
            "dx": 8,
            "color": "#223b36"
          },
          "encoding": {
            "longitude": {
              "field": "label_longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "text": {
              "field": "map_label",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 18,
      "titleFontSize": 18,
      "titleFontWeight": "normal",
      "labelColor": "#223b36",
      "titleColor": "#223b36"
    }
  }
}