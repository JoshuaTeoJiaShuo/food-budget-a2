{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Butterfly chart comparing average weekly household food spending by income quintile, Australia, 2015–16. Other food purchases extend left and meals out and fast foods extend right from a shared zero. Both sides use the same dollar scale; all spending amounts are positive.",
  "width": 640,
  "height": 380,
  "background": "#fffefa",
  "padding": 12,

  "data": {
    "url": "data/income-spending-joined.csv",
    "format": {
      "type": "csv",
      "parse": {
        "meals_weekly": "number",
        "other_food_weekly": "number"
      }
    }
  },

  "transform": [
    {
      "fold": ["meals_weekly", "other_food_weekly"],
      "as": ["spending_component", "weekly"]
    },
    {
      "calculate": "datum.spending_component === 'meals_weekly' ? 'Meals out & fast foods' : 'Other food purchases'",
      "as": "purchase_type"
    },
    {
      "calculate": "format(datum.weekly, '$,.2f')",
      "as": "value_label"
    },
    {
      "calculate": "datum.spending_component === 'other_food_weekly' ? -datum.weekly : datum.weekly",
      "as": "position"
    }
  ],

  "encoding": {
    "y": {
      "field": "income_quintile",
      "type": "ordinal",
      "sort": ["Lowest", "Second", "Third", "Fourth", "Highest"],
      "scale": {
        "paddingInner": 0.5,
        "paddingOuter": 0.25
      },
      "axis": {
        "title": null,
        "labelPadding": 12,
        "labelLimit": 160,
        "domain": false,
        "ticks": false
      }
    },

    "x": {
      "field": "position",
      "type": "quantitative",
      "stack": null,
      "scale": {
        "domain": [-260, 260],
        "zero": true,
        "nice": false
      },
      "axis": {
        "title": "Average weekly spending per household (A$)",
        "titlePadding": 18,
        "values": [-200, -100, 0, 100, 200],
        "labelExpr": "format(abs(datum.value), '$.0f')",
        "labelPadding": 8,
        "domain": false,
        "ticks": false,
        "grid": true
      }
    },

    "tooltip": [
      {
        "field": "income_quintile",
        "type": "ordinal",
        "title": "Income quintile"
      },
      {
        "field": "purchase_type",
        "type": "nominal",
        "title": "Food purchases"
      },
      {
        "field": "weekly",
        "type": "quantitative",
        "title": "Per household / week (A$)",
        "format": ".2f"
      }
    ]
  },

  "layer": [
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "rule",
        "color": "#819383",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"datum": 0},
        "y": {"value": 0},
        "y2": {"value": "height"},
        "tooltip": null
      }
    },

    {
      "mark": {
        "type": "bar",
        "stroke": "#819383",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "purchase_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Other food purchases",
              "Meals out & fast foods"
            ],
            "range": ["#c5d4c5", "#e8c8ad"]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "columns": 2,
            "columnPadding": 24,
            "labelLimit": 0,
            "symbolType": "square",
            "symbolSize": 140,
            "offset": 20
          }
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.position < 0 ? 'right' : 'left'"
        },
        "baseline": "middle",
        "dx": {
          "expr": "datum.position < 0 ? -8 : 8"
        },
        "fontSize": 18,
        "color": "#223b36"
      },
      "encoding": {
        "text": {
          "field": "value_label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 18,
      "titleFontSize": 18,
      "titleFontWeight": "normal",
      "labelColor": "#223b36",
      "titleColor": "#223b36",
      "gridColor": "#e1e5de"
    },
    "legend": {
      "labelFontSize": 18,
      "labelColor": "#223b36"
    }
  }
}